# --- Mentor chat relay (Vercel serverless functions in api/) ---
# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Telegram user ids allowed to answer students (comma separated). Each mentor must press Start on the bot once.
MENTOR_CHAT_IDS=1142658539,5199820118
# Optional hardening: a random string Telegram must send with each webhook call, and a key for /api/setup-webhook.
# TELEGRAM_WEBHOOK_SECRET=
# ADMIN_KEY=
# Upstash Redis (Vercel Marketplace → Upstash → Redis). Either pair of names works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Front end (build-time) ---
# Default chat server for the desktop app, e.g. https://your-app.vercel.app (the web build uses its own origin).
VITE_CHAT_URL=
