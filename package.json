{
  "name": "bluebook-replica",
  "productName": "Bluebook",
  "version": "1.0.0",
  "description": "Digital SAT practice testing desktop app replicating College Board Bluebook: lockdown kiosk, multistage adaptive engine, Desmos, reference sheet, annotations.",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {  
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite --port 5199 --strictPort\" \"wait-on -t 60000 http://localhost:5199 && node scripts/dev-electron.mjs\"",
    "dev:web": "vite --port 5199 --strictPort",
    "build": "vite build",
    "start": "npm run build && electron .",
    "generate:tests": "node scripts/generate-tests.mjs",
    "test": "node --test scripts/engine.test.mjs",
    "dist": "npm run build && electron-builder",
    "icons": "electron scripts/make-icons.cjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.replica.bluebook",
    "productName": "Bluebook",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "icon": "build/icon.png"
  }
}
